# Server-only: never prefix this key with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
PORT=5173
HOST=127.0.0.1
# Optional: only when the frontend is hosted separately. Public backend URL, NOT a key.
VITE_REVIEW_API_URL=
# Set to the exact frontend origin for separate hosting or an HTTPS reverse proxy.
REVIEW_ALLOWED_ORIGIN=
